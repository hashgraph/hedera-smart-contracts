# Repo-wide safety net. Each example keeps its own .gitignore for tool-specific output.

# Dependencies
node_modules/

# Secrets / local config
.env
.env.*
!.env.example
!.env.sample

# Build and test output
artifacts/
cache/
coverage/
coverage.json
typechain-types/
*.tsbuildinfo
test-results.*

# IDE / OS
.idea/
.vscode/
.DS_Store

# Claude Code local state
.claude/
